{
  "name": "paperwriter-electron",
  "version": "1.1.1",
  "private": false,
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "preload:build": "node build-preload.cjs",
    "preload:check": "node build-preload.cjs --check",
    "dev": "node build-preload.cjs && electron .",
    "dev:vite": "node build-preload.cjs && node dev-vite.cjs",
    "check": "node build-preload.cjs --check && node check-cjs.cjs",
    "test": "node --test *.test.cjs",
    "frontend:build": "npm --prefix ../frontend run build",
    "dist": "npm run frontend:build && node build-preload.cjs && electron-builder --win nsis --x64",
    "pack": "npm run frontend:build && node build-preload.cjs && electron-builder --win dir --x64",
    "publish": "npm run frontend:build && node build-preload.cjs && electron-builder --win nsis --x64 --publish always"
  },
  "dependencies": {
    "@citation-js/core": "^0.8.2",
    "@citation-js/plugin-bibtex": "^0.8.2",
    "@citation-js/plugin-csl": "^0.8.2",
    "@citation-js/plugin-ris": "^0.8.2",
    "citeproc": "^2.4.63",
    "diff": "^8.0.2",
    "docx": "^9.7.1",
    "electron-updater": "^6.8.9",
    "iconv-lite": "^0.7.3",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^5.4.624"
  },
  "devDependencies": {
    "electron": "^41.5.0",
    "electron-builder": "^26.15.3"
  },
  "productName": "笺间",
  "description": "面向个人长文、日记、复盘与资料整理的沉浸式 Windows 写作软件",
  "author": "Aecenas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aecenas/PaperWriterElectron.git"
  },
  "homepage": "https://github.com/Aecenas/PaperWriterElectron#readme",
  "build": {
    "appId": "com.aecenas.paperwriter",
    "productName": "笺间",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "artifactName": "PaperWriter-${version}-${arch}.${ext}",
    "directories": {
      "output": "../../release"
    },
    "files": [
      "**/*",
      {
        "from": "../frontend/dist",
        "to": "frontend/dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "笺间"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Aecenas",
        "repo": "PaperWriterElectron"
      }
    ]
  }
}
